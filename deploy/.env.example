# Copy to deploy/.env on the server and fill in. Never commit deploy/.env.

# Database (generate with: openssl rand -hex 24)
POSTGRES_PASSWORD=

# HTTPS origin proxy
ORIGIN_DOMAIN=api-origin.example.com
# Generate with: openssl rand -hex 32. Same value goes in the CloudFront origin header.
ORIGIN_SECRET=

# Backend settings (copy from backend/cimb-dashboard-dev-backend.env, except DATABASE_URL)
CIMB_INSIGHTS_URL=
CIMB_INSIGHTS_KEY=
GROQ_API_KEY=
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=
META_INSTAGRAM_ACCOUNT_ID=
METRICOOL_TOKEN=
METRICOOL_USER_ID=
METRICOOL_BLOG_ID=
FOLLOWER_REFRESH_SECRET=

# Dashboard sign-in (required: the API refuses every request until both are set).
# Create each entry with:  python backend/hash_password.py
# Join several users with commas:  alice:pbkdf2_sha256...,bob:pbkdf2_sha256...
DASHBOARD_USERS=
# Create with:  python backend/hash_password.py --secret   (changing it signs everyone out)
SESSION_SECRET=
